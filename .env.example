# Copy to .env. Secrets stay on the server; never use VITE_ prefixes.
PORT=4173
HOST=127.0.0.1
# DeepSeek official API, or another provider supporting /chat/completions.
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-flash
# Optional cloud transcription uses a separate provider and key.
# Leave empty to use browser recognition or manual text editing.
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_API_KEY=
ASR_MODEL=FunAudioLLM/SenseVoiceSmall
